---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Calendar, ArrowLeft } from 'lucide-react';

export async function getStaticPaths() {
  const posts = await getCollection('weeklyPmBriefing', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <div class="max-w-4xl mx-auto px-4 py-12 sm:py-20">
    <a href="/pm-briefing" class="inline-flex items-center gap-2 text-sm font-medium text-blue-600 hover:text-blue-700 mb-8">
      <ArrowLeft className="w-4 h-4" />
      <span>PM Briefing</span>
    </a>

    <article>
      <header class="mb-10">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-4">
          <Calendar className="w-4 h-4" />
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
          </time>
        </div>
        <h1 class="text-4xl font-bold text-gray-900">{post.data.title}</h1>
      </header>

      <details class="pm-legend">
        <summary>How to read the Risk, Remediation, Priority &amp; NIST RMF labels</summary>
        <dl>
          <dt>Risk</dt>
          <dd>Impact × Likelihood, each scored 1–5. Bands: 1–6 Low, 7–12 Medium, 13–19 High, 20–25 Critical.</dd>
          <dt>Remediation Type</dt>
          <dd>Data Filter, Prompt/Guardrail, Fine-tuning/RLHF, Eval-Pipeline Change, Human-in-the-loop/Process, or Other.</dd>
          <dt>Priority</dt>
          <dd><strong>Proactive</strong> — get ahead of it before it's exploited in production. <strong>Reactive</strong> — an incident or observed failure has already occurred and needs immediate attention.</dd>
          <dt>NIST RMF</dt>
          <dd><strong>Govern</strong> (policy &amp; accountability), <strong>Map</strong> (context &amp; risk identification), <strong>Measure</strong> (testing &amp; evaluation), <strong>Manage</strong> (mitigation &amp; response) — from the NIST AI Risk Management Framework.</dd>
        </dl>
      </details>

      <div class="prose prose-blue max-w-none text-gray-700 pm-findings">
        <Content />
      </div>
    </article>
  </div>
</Layout>

<style>
  /* Each finding is "### N. Title" followed by a "> **Label:** value · ..."
     blockquote (the meta line) and then plain prose paragraphs. Style that
     shape as a report-card: a bordered heading with breathing room, and the
     meta line rendered as a pill row instead of an italic quote. */
  .pm-findings :global(h3) {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e5e7eb;
  }
  .pm-findings :global(h3:first-of-type) {
    margin-top: 1.5rem;
    padding-top: 0;
    border-top: none;
  }
  .pm-findings :global(h3 + blockquote) {
    margin-top: 0.75rem;
    margin-bottom: 1.5rem;
    padding: 0;
    border: none;
    font-style: normal;
    quotes: none;
  }
  /* Tailwind Typography auto-adds open/close quote marks via ::before/::after
     on a blockquote's first/last paragraph — with a single <p> inside, both
     land on the same element. Kill them; this blockquote is a stat strip,
     not a quotation. */
  .pm-findings :global(h3 + blockquote p::before),
  .pm-findings :global(h3 + blockquote p::after) {
    content: none;
  }
  .pm-findings :global(h3 + blockquote p) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }
  .pm-findings :global(.pm-badge) {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    border-width: 1px;
    white-space: nowrap;
  }
  .pm-findings :global(.pm-badge-label) {
    text-transform: uppercase;
    letter-spacing: 0.03em;
    opacity: 0.7;
    font-weight: 600;
    font-size: 0.65rem;
  }

  /* Threat model / Trade-offs paragraphs, boxed in the same light-bg +
     colored-border language as the badges, so each field type is visually
     distinct at a glance while reading down the card. */
  .pm-findings :global(.pm-box) {
    padding: 0.85rem 1.1rem;
    border-radius: 0.6rem;
    border-width: 1px;
  }
  .pm-findings :global(.pm-box-threat) {
    background-color: #eff6ff;
    border-color: #bfdbfe;
  }
  .pm-findings :global(.pm-box-threat > strong:first-child) {
    color: #1d4ed8;
  }
  .pm-findings :global(.pm-box-tradeoff) {
    background-color: #fffbeb;
    border-color: #fde68a;
  }
  .pm-findings :global(.pm-box-tradeoff > strong:first-child) {
    color: #b45309;
  }
  .pm-findings :global(.pm-box-summary) {
    background-color: #f9fafb;
    border-color: #e5e7eb;
  }

  .pm-legend {
    margin-bottom: 2rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.6rem;
    padding: 0.85rem 1.1rem;
    background-color: #fafafa;
  }
  .pm-legend summary {
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    color: #374151;
  }
  .pm-legend dl {
    margin-top: 0.85rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1rem;
    font-size: 0.875rem;
    color: #4b5563;
  }
  .pm-legend dt {
    font-weight: 600;
    color: #111827;
    white-space: nowrap;
  }
  .pm-legend dd {
    margin: 0;
  }
</style>

<script>
  // Progressive enhancement only: turns the "**Label:** value · **Label:** value"
  // meta-line blockquote right after each finding's h3 into a row of colored
  // pill badges. If this script fails to run for any reason, the blockquote
  // still reads fine as plain bold-labeled text — no content is hidden by it.
  function colorFor(label: string, value: string) {
    const v = value.toLowerCase();
    if (label.toLowerCase().startsWith('risk')) {
      if (v.includes('critical')) return 'pm-badge bg-red-50 text-red-700 border-red-200';
      if (v.includes('high')) return 'pm-badge bg-orange-50 text-orange-700 border-orange-200';
      if (v.includes('medium')) return 'pm-badge bg-amber-50 text-amber-700 border-amber-200';
      if (v.includes('low')) return 'pm-badge bg-emerald-50 text-emerald-700 border-emerald-200';
    }
    if (label.toLowerCase().startsWith('priority')) {
      if (v.includes('reactive')) return 'pm-badge bg-purple-50 text-purple-700 border-purple-200';
      if (v.includes('proactive')) return 'pm-badge bg-blue-50 text-blue-700 border-blue-200';
    }
    return 'pm-badge bg-gray-50 text-gray-700 border-gray-200';
  }

  document.querySelectorAll('.pm-findings h3').forEach((h3) => {
    const bq = h3.nextElementSibling;
    if (!bq || bq.tagName !== 'BLOCKQUOTE') return;
    const p = bq.querySelector(':scope > p');
    if (p) {
      const html = p.innerHTML;
      // Split on the middle-dot separator the prompt is instructed to use.
      const segments = html.split(/\s*·\s*/);
      const frag = document.createDocumentFragment();
      let matchedAny = false;
      for (const seg of segments) {
        const m = seg.match(/^<strong>([^<:]+):?<\/strong>\s*(.*)$/s);
        if (!m) continue;
        matchedAny = true;
        const [, label, value] = m;
        const span = document.createElement('span');
        span.className = colorFor(label, value);
        const labelSpan = document.createElement('span');
        labelSpan.className = 'pm-badge-label';
        labelSpan.textContent = label;
        span.appendChild(labelSpan);
        const valueSpan = document.createElement('span');
        valueSpan.innerHTML = value;
        span.appendChild(valueSpan);
        frag.appendChild(span);
      }
      if (matchedAny) {
        p.innerHTML = '';
        p.appendChild(frag);
      }
    }

    // Box the summary / Threat model / Trade-offs paragraphs that follow, in
    // the same light-bg + colored-border language as the badges above. The
    // summary (the plain paragraph right after the meta line, before any
    // labeled field) gets the same neutral gray as the Remediation badge.
    let el = bq.nextElementSibling;
    let sawSummary = false;
    while (el && el.tagName !== 'H3') {
      const text = el.textContent || '';
      if (/^Threat model:/i.test(text)) {
        el.classList.add('pm-box', 'pm-box-threat');
      } else if (/^Trade-offs:/i.test(text)) {
        el.classList.add('pm-box', 'pm-box-tradeoff');
      } else if (!sawSummary && el.tagName === 'P') {
        el.classList.add('pm-box', 'pm-box-summary');
        sawSummary = true;
      }
      el = el.nextElementSibling;
    }
  });
</script>
